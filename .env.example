# ==============================================================
#  Memayu configuration
#  Copy this file to `.env` and fill in your values.
#  Everything is optional except the provider keys you plan to use.
#  `make dev` loads `.env` automatically if it is present.
# ==============================================================

# ---------------------------------------------------------------
#  Server
# ---------------------------------------------------------------
MEMAYU_BIND_ADDR=0.0.0.0
MEMAYU_PORT=18080


# ---------------------------------------------------------------
#  Storage
# ---------------------------------------------------------------
# Backend: libsql (embedded, default) or postgres.
MEMAYU_STORAGE_BACKEND=libsql

# libsql database file (default: ./memayu.db)
MEMAYU_LIBSQL_PATH=./memayu.db

# Required when MEMAYU_STORAGE_BACKEND=postgres
# MEMAYU_DATABASE_URL=postgres://user:pass@host:5432/memayu


# ---------------------------------------------------------------
#  Extraction mode
# ---------------------------------------------------------------
# raw (default): store text verbatim, skip the LLM; dedupe threshold 0.98.
# llm: extract + merge memory via the LLM provider below.
MEMAYU_EXTRACTION_MODE=raw


# ---------------------------------------------------------------
#  LLM provider — OpenAI-compatible
#  Only needed when MEMAYU_EXTRACTION_MODE=llm.
# ---------------------------------------------------------------
# MEMAYU_LLM_BASE_URL=https://api.deepseek.com/v1
# MEMAYU_LLM_API_KEY=sk-
# MEMAYU_LLM_MODEL=deepseek-chat


# ---------------------------------------------------------------
#  Embedding provider
# ---------------------------------------------------------------
# Choose ONE backend:
#
#   MEMAYU_EMBEDDER_BACKEND=local   (default) — runs a local embedder model
#   MEMAYU_EMBEDDER_BACKEND=remote  — OpenAI-compatible / BYOK.
MEMAYU_EMBEDDER_BACKEND=local

# --- Local backend (on-device) ---
# Default embedder. No API key or network calls needed.
MEMAYU_EMBEDDER_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
#
# MEMAYU_EMBEDDER_DIM=768

# --- Remote backend (BYOK) ---
# MEMAYU_EMBEDDER_BACKEND=remote
# MEMAYU_EMBEDDER_BASE_URL=https://api.openai.com/v1
# MEMAYU_EMBEDDER_API_KEY=sk-
# MEMAYU_EMBEDDER_MODEL=text-embedding-3-small


# ---------------------------------------------------------------
#  Behavior
# ---------------------------------------------------------------
# ADD vs UPDATE candidate similarity threshold (default 0.85)
# MEMAYU_SIMILARITY_THRESHOLD=0.85
